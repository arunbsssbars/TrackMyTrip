# =================================================================
# TrackMyTrip Environment Configuration & Secrets Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' at the project root:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Fill in your actual credentials below.
# 3. NEVER commit the actual '.env' or any '.env.*' file to Git!
# 4. For compile-time injection during builds:
#    flutter build apk --dart-define-from-file=.env
# =================================================================

# Application Environment Mode: development | staging | production
APP_ENV=development

# Application Identifiers
APP_NAME=TrackMyTrip
APP_BASE_URL=https://trackmytrip.app

# Google Maps Platform API Key (Android / iOS / Web)
# Format: AIzaSy... (39 characters)
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase Project & Client Identifiers
FIREBASE_PROJECT_ID=trackmytrip-sync-2026
FIREBASE_APP_ID=1:731719697818:web:7765ef639c831331bce623
FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE

# Security & Hardware Storage Vault Pepper (Used for local vault obfuscation)
# Must be at least 16 characters in production.
APP_VAULT_PEPPER=trackmytrip_default_pepper_salt_2026

# Feature Flags & Logging (debug | info | warn | error)
LOG_LEVEL=debug
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=true

# DevOps & CI/CD Telemetry
CI_RUNNER_ID=local_developer_machine

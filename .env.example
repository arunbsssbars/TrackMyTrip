# =================================================================
# TrackMyTrip Environment Configuration & Secrets Template
# Copy this file to '.env' and fill in your actual production/test keys.
# NEVER commit the actual '.env' or '.env.production' file to Git!
# =================================================================

# Application Environment Mode: development | staging | production
APP_ENV=development

# Google Maps Platform API Key (Android / iOS / Web)
# Format: AIzaSy... (39 characters)
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase Web App & Service Identifiers (Optional overrides)
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_PROJECT_ID=trackmytrip-prod

# Encryption & Security Salt (Used for local vault obfuscation)
APP_VAULT_PEPPER=default_trackmytrip_local_pepper_change_in_production

# DevOps & CI/CD Telemetry
CI_RUNNER_ID=local_developer_machine

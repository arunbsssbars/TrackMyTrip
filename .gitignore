# =================================================================
# TrackMyTrip - Standard Git Ignore Configuration
# =================================================================

# Operating System & Editors
.DS_Store
*.swp
*.class
*.log
*.pyc
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IDE & Editor Configurations
*.iml
*.ipr
*.iws
.idea/
.antigravity/
# .vscode/ (launch configs intentionally managed for team productivity)

# Node & Cloud Functions
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter / Dart / Pub Generated Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
build/ios_derived

# Android Build Artifacts & Local Files
/android/app/debug
/android/app/profile
/android/app/release
.kotlin/
android/local.properties
android/.gradle/

# iOS Generated Files
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Secrets, Keystores & Environment Credentials
**/key.properties
*.jks
*.keystore
.env*
!.env.example
google-services.json.secret
GoogleService-Info.plist.secret

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection
    match /rooms/{roomCode} {
      // Anyone can read a room if they have the code (since document ID is the code)
      allow read: if true;
      // Only authenticated users (even anonymous) can create/update
      allow write: if request.auth != null;
    }
    
    // Mutations collection (deprecated but keeping for backwards compat if needed)
    match /mutations/{mutationId} {
      allow read, write: if request.auth != null;
    }
  }
}
